# AutoLead Systems - Environment Configuration Example
# Cổng chạy ứng dụng full-stack (Backend API + Client)
PORT=5173

# Chế độ môi trường (development / production)
NODE_ENV=production

# Thiết lập đường dẫn API (nếu chạy frontend và backend riêng)
# VITE_API_URL=http://localhost:5173

# Cấu hình Demo Account (An toàn, không chứa mật khẩu sản xuất)
DEMO_DEALER_EMAIL=dealer@haxaco.vn
DEMO_DEALER_PASSWORD=demo123
